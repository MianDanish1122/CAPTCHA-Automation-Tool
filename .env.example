# Application Environment Configuration
APP_NAME="CAPTCHA Automation Tool"
APP_ENV="development"
DEBUG=true

# Server Settings
HOST="127.0.0.1"
PORT=8000

# Security & Scanning Controls (CRITICAL: Keep false for offline/safe testing)
ENABLE_LIVE_SCAN=false
ALLOWED_DOMAINS="example.com,demo.com,localhost"
REQUEST_TIMEOUT_MS=15000
MAX_CONCURRENT_PAGES=3

# SSRF Protection & Loopback Policy
# ALLOW_DEV_LOOPBACK is strictly server-controlled and only active when APP_ENV in ("development", "test").
# In staging and production, loopback requests are unconditionally rejected by SecurityGuard.
ALLOW_DEV_LOOPBACK=false

# Authentication & Session Security (Phase 5)
JWT_SECRET_KEY="change-me-to-a-secure-random-secret-for-production-use"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins (Comma-separated, never wildcard in production)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Rate Limiting Controls (Token-bucket per client IP)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_INSPECT_PER_MIN=10
RATE_LIMIT_BATCH_PER_MIN=10
RATE_LIMIT_REVIEWS_PER_MIN=30
RATE_LIMIT_BENCHMARK_PER_MIN=5

# Resource Protection
MAX_CSV_FILE_SIZE_BYTES=5242880
MAX_CSV_ROWS=300

# Database
DATABASE_URL="sqlite:///./data/captcha_tool.db"

# OCR Configuration
TESSERACT_CMD="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"

# Google reCAPTCHA Official Test Credentials (Public test key & secret provided by Google)
# Site Key: 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Secret Key: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_TEST_SITE_KEY="6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI"
RECAPTCHA_TEST_SECRET_KEY="6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe"

# --- Phase 6A security controls ---
# Comma-separated IPs/CIDRs of reverse proxies you operate (e.g. 10.0.0.0/8,172.16.0.5).
# X-Forwarded-For is honored ONLY when the direct TCP peer is in this list. Empty = never trust it.
TRUSTED_PROXIES=
# `fixture://` demo pages are honored only when APP_ENV is development or test.
ALLOW_FIXTURES=true
# Development-only escape hatch for self-signed certificates. Rejected at startup in staging/production.
SCAN_ALLOW_INVALID_CERTS=false
# Max bytes of any single proxied response during guarded browsing.
GUARD_MAX_RESPONSE_BYTES=10485760

# --- Phase 6B security controls ---
# Leave EMPTY normally. Provision the first admin with `python -m app.cli create-admin`.
# If you must use the HTTP bootstrap endpoint, set a random >=24 char secret, send it as the
# X-Setup-Token header, then REMOVE it again once the admin exists.
INITIAL_ADMIN_SETUP_TOKEN=
# HMAC key for the tamper-evident audit chain. SET THIS EXPLICITLY and keep it stable: if it is
# empty the key is derived from JWT_SECRET_KEY, and rotating that secret makes old entries unverifiable.
AUDIT_HMAC_KEY=
MAX_JSON_BODY_BYTES=2097152
MAX_HTML_CHARS=200000
MAX_IMAGE_BYTES=1048576
MAX_IMAGE_PIXELS=4000000
RATE_LIMIT_COMPUTE_PER_MIN=30
RATE_LIMIT_ADMIN_PER_MIN=20
RATE_LIMIT_SETUP_PER_MIN=3
MAX_CONCURRENT_CRAWLS=2
MAX_CONCURRENT_BATCH_JOBS=1
MAX_ACTIVE_JOBS_PER_USER=2

# --- Phase 6B final review ---
# Audit key rotation: put the NEW key in AUDIT_HMAC_KEY and the OLD key(s) here (comma-separated) so
# entries sealed before the rotation still verify. Generate a key with: python -m app.cli generate-audit-key
AUDIT_HMAC_KEYS_PREVIOUS=
# Pre-key-id (legacy) audit entries were sealed with a key derived from JWT_SECRET_KEY. Keep true only
# while such entries exist; they must form a prefix of the chain.
AUDIT_ALLOW_LEGACY_DERIVED_KEY=true
# true (default): JWTs issued before Phase 6B (no `ver` claim) are rejected -> one forced re-login.
JWT_REQUIRE_VER_CLAIM=true
